{
  "name": "claude-design-codex-parity",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "vitest run tests/contracts && node packages/contracts/scripts/write-contract-diff-report.mjs",
    "test:registry": "vitest run tests/registry",
    "test:integration": "vitest run tests/integration",
    "check:parity-coverage": "node packages/command-registry/scripts/check-parity-coverage.mjs",
    "phase0:verify": "pnpm test:contracts && pnpm test:registry && pnpm run check:parity-coverage",
    "phase1:verify": "pnpm phase0:verify && pnpm test:integration"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.59.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  }
}
